# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT TEMPLATE — safe to commit, contains NO real secrets.
# Copy this file to .env, fill in real values, and never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Database name created on first boot.
POSTGRES_DB=sentinel

# Database superuser for the sentinel schema.
POSTGRES_USER=sentinel_user

# Strong, unique password — minimum 20 characters recommended.
POSTGRES_PASSWORD=<replace_with_strong_password>

# ── Backend datasource ────────────────────────────────────────────────────────
# Must match the PostgreSQL values above.
DB_HOST=db
DB_PORT=5432
DB_NAME=sentinel
DB_USER=sentinel_user
DB_PASSWORD=<replace_with_strong_password>

# Frontend reverse proxy target used by nginx inside the frontend container.
BACKEND_URL=backend:8080

# CORS allowed origins (comma-separated)
# Local example: http://localhost:3000
# Render example: https://<your-frontend-service>.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── JWT / OAuth2 ──────────────────────────────────────────────────────────────
# Point to your real Identity Provider (Keycloak, Auth0, Okta, etc.).
# Example (Keycloak):  https://auth.example.com/realms/sentinel
# Example (Auth0):     https://<tenant>.auth0.com/
JWT_ISSUER_URI=<replace_with_idp_issuer_uri>
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=<replace_with_idp_issuer_uri>

# ── App tuning (non-sensitive) ────────────────────────────────────────────────
SERVER_PORT=8080
INGESTION_INTERVAL_MS=5000

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION NOTES
# In production, do NOT use .env files on disk. Inject secrets via:
#   • CI/CD pipeline secrets (GitHub Actions, GitLab CI, etc.)
#   • Docker Swarm secrets  (docker secret create ...)
#   • Kubernetes secrets    (kubectl create secret generic ...)
#   • Secrets manager       (HashiCorp Vault, AWS Secrets Manager, GCP Secret Manager)
# ─────────────────────────────────────────────────────────────────────────────
